http://gcs.local {
	@health path /health
	handle @health {
		respond "ok" 200
	}

	redir https://gcs.local{uri} 308
}

https://gcs.local {
	tls internal

	@health path /health
	handle @health {
		respond "ok" 200
	}

	# Special-case health: /api/health -> /health
	handle /api/health {
		rewrite * /health
		reverse_proxy api:8000
	}

	# All other API paths: DO NOT STRIP /api
	handle /api/* {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy web:80
	}
}